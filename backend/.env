# App port
PORT=4000

# Database connection string
# Format: postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_tasks

# Secret key for JWT (change this to any random string before deploying)
JWT_SECRET=my_super_secret_key_123

# Number of rounds bcrypt uses for password hashing
BCRYPT_SALT_ROUNDS=10
